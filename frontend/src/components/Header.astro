---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: 'Menú' },
  { href: '/historia', label: 'Nuestra historia' },
  { href: '/login', label: 'Acceso / Login' },
];
---

<header class="header">
  <div class="header-inner">
    <a href="/" class="brand" style="text-decoration: none; color: inherit;">
      <svg class="mark" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="15" stroke="var(--green)" stroke-width="1.4"></circle>
        <path d="M11 20c0-4 2.5-8 5-9 2.5 1 5 5 5 9" stroke="var(--green)" stroke-width="1.4" stroke-linecap="round"></path>
        <path d="M16 11V8" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round"></path>
      </svg>
      <span>La Caleta del Sabor</span>
    </a>

    <nav class="main-nav">
      {
        navItems.map((item) => {
          const isActive = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
          return (
            <a href={item.href} class={isActive ? 'active' : ''}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
