---
const currentYear = new Date().getFullYear();
---

<footer class="footer-wrap">
  <div class="footer-inner">
    <div>
      <p class="footer-title">La Caleta del Sabor</p>
      <p class="footer-sub">Cocina Criolla & Marina • Lima, Perú</p>
    </div>
    <div class="footer-links">
      <a href="/#menu">Menú</a>
      <a href="/#historia">Nosotros</a>
      <a href="/login">Acceso Personal</a>
    </div>
    <p class="footer-copy">© {currentYear} La Caleta del Sabor. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer-wrap {
    border-top: 1px solid var(--line);
    background: var(--bg-panel);
    padding: 32px 0;
    margin-top: 60px;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .footer-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--green);
    font-size: 1.1rem;
    margin: 0 0 2px;
  }
  .footer-sub {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .footer-links {
    display: flex;
    gap: 20px;
  }
  .footer-links a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .footer-links a:hover {
    color: var(--ink);
  }
  .footer-copy {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
</style>
