---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/panel/mesero', label: 'Mesas & Comandas' },
  { href: '/panel/cocina', label: 'Cocina (KDS)' },
  { href: '/panel/caja', label: 'Caja' },
];
---

<header class="header">
  <div class="header-inner">
    <a href="/panel/mesero" class="brand" style="text-decoration: none; color: inherit;">
      <svg class="mark" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="15" stroke="var(--green)" stroke-width="1.4"></circle>
        <path d="M11 20c0-4 2.5-8 5-9 2.5 1 5 5 5 9" stroke="var(--green)" stroke-width="1.4" stroke-linecap="round"></path>
        <path d="M16 11V8" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round"></path>
      </svg>
      <span>Panel Operativo</span>
    </a>

    <nav class="main-nav">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={pathname.startsWith(item.href) ? 'active' : ''}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/" style="margin-left: 12px; color: var(--gold);">Ir a Tienda</a>
    </nav>
  </div>
</header>
