---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
---

<LayoutAdmin title="Pantalla de Cocina (KDS)">
  <div style="background: var(--bg-panel); border: 1px solid var(--line); border-radius: 4px; padding: 32px; text-align: center;">
    <h1 style="font-family: var(--font-display); font-size: 1.8rem; margin: 0 0 12px; color: var(--green);">
      Pantalla de Cocina (KDS)
    </h1>
    <p style="color: var(--ink-soft); max-width: 520px; margin: 0 auto 24px; font-size: 0.95rem;">
      Esta vista corresponde a la preparación de comandas en tiempo real. Se alimenta de la vista <code>v_pedidos_cocina</code> para actualizar el estado del pedido a <em>listo</em> con su <code>hora_listo</code>.
    </p>

    <div style="border: 2px dashed var(--line); border-radius: 6px; padding: 40px 20px; color: var(--ink-faint);">
      Zona disponible para implementar las tarjetas de pedidos pendientes
    </div>
  </div>
</LayoutAdmin>
