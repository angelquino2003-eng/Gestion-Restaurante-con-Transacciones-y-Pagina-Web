---
import LayoutPublic from '../layouts/LayoutPublic.astro';
---

<LayoutPublic title="Página no encontrada">
  <div style="min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 20px;">
    <h1 style="font-family: var(--font-display); font-size: 3rem; color: var(--green); margin: 0 0 12px;">404</h1>
    <p style="color: var(--ink-soft); margin: 0 0 24px;">La página que estás buscando no existe o fue movida.</p>
    <a href="/" style="background: var(--green); color: var(--white); text-decoration: none; padding: 10px 18px; border-radius: 4px; font-weight: 600;">
      Volver al Inicio
    </a>
  </div>
</LayoutPublic>
